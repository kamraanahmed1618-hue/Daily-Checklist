# Copy to .env (or export these directly) for local development.
# Never commit a real .env file - it's already covered by .gitignore.

# PostgreSQL connection string. Omit this for local testing to fall back to
# a SQLite file at data/ohs.db (set OHS_DB_PATH to change that path).
DATABASE_URL=postgresql://user:password@localhost:5432/ohs_checklist

# Flask session signing key. Render's blueprint generates this automatically
# in production - set your own long random value for local development.
SECRET_KEY=replace-this-with-a-long-random-value

# Password for the shared /admin login (Records, HSE Statistics, Data
# Management). Required - the admin area refuses to work without it.
ADMIN_PASSWORD=replace-this-for-local-testing

# Optional: enables the /admin/backup CSV/ZIP export endpoint.
EXPORT_TOKEN=

# Optional: Backblaze B2 (S3-compatible) storage for photo uploads on
# near-miss reports and violation notices. Photo upload is disabled until
# all four of these are set.
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_ENDPOINT=
